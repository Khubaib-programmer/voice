NODE_ENV=development
PORT=4000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/voice_translator?schema=public
COOKIE_SECRET=replace-with-at-least-32-random-characters
ML_SERVICE_URL=http://127.0.0.1:8000
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# Optional locally when using a service-account JSON; ADC can also come from `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json
MAX_AUDIO_BYTES=10485760
